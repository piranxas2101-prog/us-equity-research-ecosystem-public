{
  "universe": {
    "mode": "sec_us_list",
    "include_exchanges": ["Nasdaq", "NYSE", "NYSE American"],
    "max_symbols": 10,
    "exclude_name_keywords": [
      "warrant",
      "right",
      "unit",
      "preferred",
      "depositary share",
      "etf",
      "exchange traded fund",
      "etn",
      "fund",
      "blank check",
      "acquisition corp",
      "acquisition corporation",
      "spac"
    ],
    "cache_file": "cache/sec_company_tickers_exchange.json",
    "cache_max_age_hours": 24
  },
  "scan": {
    "lookback_days": 260,
    "min_history_days": 60,
    "top_n": 5,
    "max_price": 1000.0,
    "min_composite_score": 0.0
  },
  "data_sources": {
    "sec": {
      "enabled": false,
      "include_forms": ["10-K", "10-Q", "8-K", "20-F", "6-K"],
      "max_recent_filings": 0,
      "max_filing_age_days": 30,
      "ticker_cik_cache_file": "cache/sec_company_tickers.json",
      "cache_max_age_hours": 24
    },
    "market_data": {
      "provider_priority": ["yfinance"],
      "openbb_provider": "yfinance",
      "alpaca_feed": "iex",
      "adjustment": "raw",
      "bars_limit": 1000
    },
    "openbb_research": {
      "enabled": false
    },
    "macro": {
      "fred": {
        "enabled": false,
        "max_observation_age_days": 30,
        "series_ids": []
      }
    }
  },
  "database": {
    "enabled": true,
    "path": "data/market_intel.db"
  },
  "weights": {
    "moving_average": 0.35,
    "fundamental": 0.65
  },
  "moving_average_rules": [
    {
      "metric": "close_above_sma_50",
      "operator": ">=",
      "value": 1,
      "weight": 1.5
    },
    {
      "metric": "close_above_sma_200",
      "operator": ">=",
      "value": 1,
      "weight": 2.0
    },
    {
      "metric": "sma_50_above_sma_200",
      "operator": ">=",
      "value": 1,
      "weight": 2.0
    },
    {
      "metric": "close_to_sma_200_pct",
      "operator": ">=",
      "value": -12,
      "weight": 1.0
    }
  ],
  "fundamental_rules": [
    {
      "metric": "roe",
      "operator": ">=",
      "value": 0.12,
      "weight": 2.0
    },
    {
      "metric": "profit_margin",
      "operator": ">=",
      "value": 0.10,
      "weight": 1.5
    },
    {
      "metric": "gross_margin",
      "operator": ">=",
      "value": 0.30,
      "weight": 1.0
    },
    {
      "metric": "revenue_growth",
      "operator": ">=",
      "value": 0.05,
      "weight": 1.5
    },
    {
      "metric": "earnings_growth",
      "operator": ">=",
      "value": 0.05,
      "weight": 1.5
    },
    {
      "metric": "debt_to_equity",
      "operator": "<=",
      "value": 150,
      "weight": 1.0
    },
    {
      "metric": "current_ratio",
      "operator": ">=",
      "value": 1.0,
      "weight": 1.0
    },
    {
      "metric": "forward_pe",
      "operator": "<=",
      "value": 35,
      "weight": 1.0
    }
  ],
  "ollama": {
    "enabled": false,
    "host": "http://127.0.0.1:11434",
    "model": "",
    "temperature": 0.2,
    "num_predict": 120,
    "timeout_seconds": 60,
    "agent_prompt_file": "agent_prompt.txt"
  },
  "output": {
    "dir": "output"
  }
}
