{
  "policy_id": "listing-classification-governance",
  "version": "1.3.0",
  "principles": [
    "asset_type_before_issuer_sector",
    "preserve_more_specific_compatible_classification",
    "never_promote_provisional_to_verified_automatically",
    "every_change_requires_an_approved_immutable_batch",
    "automatic_approval_only_when_independent_sources_agree",
    "safe_ancestor_when_evidence_stops_agreeing",
    "missing_data_is_explicit_and_never_inferred"
  ],
  "automatic_agreement": {
    "enabled": true,
    "decided_by": "workspace owner, 2026-09-28",
    "min_independent_sources": 2,
    "sources": ["directory", "profile", "sec"],
    "advisory_only": ["description (local LLM): shown to the reviewer, never counted toward agreement"],
    "rule": "Walk down the taxonomy while at least two independent sources agree and no other pair disagrees; keep a more specific current node only when no source contradicts it; otherwise use the corroborated ancestor. Instrument type changes need two agreeing signals (SPAC: SIC 6770 and name; fund: two of SEC/SIC, name, profile). No agreement on a sector, or a change contradicting an earlier approved correction, goes to human review with its evidence.",
    "status_after_apply": "approved_provisional"
  },
  "required_common": [
    "ticker",
    "venue",
    "name",
    "instrument_type",
    "snapshot_id",
    "evidence.provider",
    "evidence.url",
    "evidence.observed_at",
    "evidence.hash"
  ],
  "instrument_contracts": {
    "equity_candidate": {
      "required": ["issuer.cik", "classification.node_id_or_unresolved_reason"],
      "optional": ["share_class", "figi"]
    },
    "adr_candidate": {
      "required": ["issuer.cik", "classification.node_id_or_unresolved_reason", "adr.status"],
      "optional": ["adr.ratio", "depositary"]
    },
    "etf": {
      "required": ["fund.sponsor_or_unresolved_reason", "fund.strategy_or_index_or_unresolved_reason"],
      "issuer_sector_required": false
    },
    "fund_candidate": {
      "required": ["fund.type_or_unresolved_reason"],
      "issuer_sector_required": false
    },
    "etn": {
      "required": ["issuer_or_guarantor", "note.underlying_or_strategy"],
      "issuer_sector_required": false
    },
    "preferred": {
      "required": ["parent_issuer_or_unresolved_reason", "security.terms_or_source"],
      "issuer_sector_required": false
    },
    "debt": {
      "required": ["parent_issuer_or_unresolved_reason", "security.terms_or_source"],
      "issuer_sector_required": false
    },
    "warrant": {
      "required": ["underlying_or_unresolved_reason", "security.terms_or_source"],
      "issuer_sector_required": false
    },
    "right": {
      "required": ["underlying_or_unresolved_reason", "security.terms_or_source"],
      "issuer_sector_required": false
    },
    "unit": {
      "required": ["components_or_unresolved_reason"],
      "issuer_sector_required": false
    },
    "spac": {
      "required": ["spac.stage", "sponsor_or_unresolved_reason"],
      "optional": ["announced_target"],
      "issuer_sector_required_before_business_combination": false
    },
    "unknown_instrument": {
      "required": ["unresolved_reason", "source_attempts"]
    }
  },
  "automatic_candidate_rules": {
    "allowed_relations": ["new_assignment", "deeper_assignment"],
    "allowed_basis": ["explicit_sic_crosswalk"],
    "required_source_status": "ok",
    "required_identity": "non_conflicting_cik",
    "still_requires_batch_approval": true
  },
  "sic_candidate_controls": {
    "allowed_exact_codes": [
      "1041", "1311", "1381", "1382", "1389", "1531", "2082", "2085", "2086", "2111",
      "2421", "2611", "2653", "2711", "2812", "2833", "2835", "2836", "2844", "2873",
      "2911", "3312", "3334", "3533", "3571", "3572", "3576", "3577", "3661", "3674", "3690", "3711", "3714",
      "3826", "3841", "3842", "3844", "3845", "4011", "4213", "4412", "4512", "4612",
      "4731", "4813", "4832", "4833", "4841", "4899", "4911", "4922", "4931", "4941",
      "5411", "5812", "5961", "6021", "6022", "6035", "6141", "6162", "6211", "6282",
      "6311", "6331", "6411", "6500", "6531", "7011", "7310", "7311", "7370", "7371", "7372", "7373", "7374", "7812", "8071", "8200"
    ],
    "semantic_review_codes": {
      "2834": "Pharmaceutical preparations does not reliably distinguish pharma from biotech or specialty therapeutics.",
      "6798": "SEC REIT metadata does not distinguish equity REITs from mortgage REITs."
    },
    "default_for_unlisted_exact_code": "human_review"
  },
  "mandatory_review": [
    "cross_sector_conflict",
    "different_branch_same_sector",
    "asset_type_change",
    "identity_conflict",
    "range_mapping",
    "missing_or_unavailable_evidence",
    "taxonomy_gap"
  ],
  "rejected_as_change": [
    "existing_more_specific",
    "same_node",
    "provider_profile_unavailable",
    "node_outside_current_taxonomy"
  ]
}
