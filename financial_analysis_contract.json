{
  "schema": "ecosystem.financial_analysis_contract.v2",
  "version": "2.0.0",
  "agent_id": "giannis",
  "role": "central_financial_quality_analyst",
  "inputs": [
    "babis_classification_record",
    "sector_context_packet.v1",
    "financial_evidence_packet.v1",
    "financial_readiness.v1",
    "open_evidence_gaps"
  ],
  "analysis_blocks": [
    "revenue_growth_and_driver_consistency",
    "margin_structure_and_operating_leverage",
    "earnings_quality_and_adjustments",
    "operating_and_free_cash_flow",
    "cash_conversion",
    "liquidity_debt_and_maturity_profile",
    "capital_intensity_and_reinvestment",
    "share_count_dilution_and_stock_compensation",
    "capital_allocation",
    "return_on_invested_capital",
    "financial_fragility_and_runway",
    "sector_kpi_to_financial_statement_reconciliation"
  ],
  "outputs": {
    "schema": "ecosystem.fundamental_analysis_packet.v2",
    "required_fields": [
      "packet_id", "run_id", "symbol", "sector_context_packet_id",
      "periods", "currency", "units", "normalized_financials_ref",
      "growth_analysis", "margin_analysis", "earnings_quality",
      "cash_flow_analysis", "balance_sheet_analysis", "capital_allocation",
      "dilution_analysis", "sector_kpi_reconciliation", "financial_risks",
      "source_references", "unknown_fields", "evidence_gap_ids",
      "confidence", "claim_source_links", "input_packet_ids",
      "input_signature", "created_at"
    ]
  },
  "boundaries": [
    "does_not_change_babis_classification",
    "does_not_rewrite_sector_agent_evidence",
    "does_not_use_technical_analysis",
    "does_not_issue_trade_instructions",
    "does_not_invent_missing_financial_values",
    "does_not_mix_incompatible_run_ids",
    "requires_readiness_gate_pass",
    "maximum_one_synthesis_call_per_eligible_symbol",
    "reviewer_disabled_by_default",
    "no_automatic_retry_after_rate_limit"
  ]
}
