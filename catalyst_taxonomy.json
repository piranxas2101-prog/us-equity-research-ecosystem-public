{
  "schema_version": 1,
  "status": "advisory_v1",
  "purpose": "Classify why a security deserves attention now without treating materiality as automatically bullish.",
  "scoring": {
    "components": {
      "category_materiality": 0.45,
      "evidence_confidence": 0.25,
      "recency": 0.20,
      "specificity": 0.10
    },
    "priority_thresholds": {
      "critical": 80,
      "high": 65,
      "medium": 50,
      "low": 35,
      "monitor": 0
    },
    "source_confidence": {
      "sec_item": 5,
      "sec_form": 4,
      "regulator_primary": 5,
      "company_primary": 4,
      "market_news": 2,
      "unknown": 1
    },
    "specificity": {
      "sec_item": 5,
      "sec_form": 3,
      "keyword_primary": 4,
      "keyword_news": 2,
      "unknown": 1
    },
    "recency_bands": [
      {"max_age_days": 3, "score": 5},
      {"max_age_days": 7, "score": 4},
      {"max_age_days": 14, "score": 3},
      {"max_age_days": 30, "score": 2},
      {"max_age_days": 36500, "score": 1}
    ]
  },
  "trade_lens_scoring": {
    "status": "advisory_only_no_auto_execution",
    "description": "Long and short scores measure catalyst support for each thesis. They are not trade instructions and do not replace valuation, technical, liquidity, borrow, or risk controls.",
    "direction_alignment": {
      "positive": {"long": 1.0, "short": 0.0},
      "negative": {"long": 0.0, "short": 1.0},
      "mixed": {"long": 0.3, "short": 0.3},
      "unknown": {"long": 0.0, "short": 0.0}
    },
    "confidence_multiplier": {
      "high": 1.0,
      "medium": 0.75,
      "low": 0.45
    },
    "aggregation": {
      "highest_child_weight": 1.0,
      "second_child_weight": 0.2,
      "third_child_weight": 0.1,
      "maximum_score": 100
    },
    "bias_minimum_score": 55,
    "bias_minimum_gap": 15
  },
  "categories": {
    "earnings_guidance": {
      "label": "Earnings & Guidance",
      "reader_question": "Did reported results, guidance, KPIs, or accounting information change the earnings path?",
      "description": "Reported financial results, preannouncements, guidance changes, KPI disclosures, restatements, or material accounting updates.",
      "base_materiality": 4,
      "long_relevance": 5,
      "short_relevance": 5,
      "default_direction": "mixed",
      "legacy_bucket": "Pre-Earnings",
      "keywords": ["earnings", "financial results", "quarterly results", "annual results", "guidance", "revenue", "profit", "loss", "restatement", "preliminary results"],
      "positive_keywords": ["raises guidance", "beats", "record revenue", "profitability"],
      "negative_keywords": ["cuts guidance", "misses", "restatement", "material weakness", "going concern"]
    },
    "commercial_customer": {
      "label": "Commercial, Customer & Partnership",
      "reader_question": "Is there a contract, customer, partnership, backlog, or commercialization event with economic substance?",
      "description": "Material agreements, customer wins, contracts, partnerships, backlog changes, go-lives, or channel developments.",
      "base_materiality": 4,
      "long_relevance": 4,
      "short_relevance": 4,
      "default_direction": "mixed",
      "legacy_bucket": "Contract / Partnership",
      "keywords": ["contract", "customer", "partnership", "strategic agreement", "purchase order", "backlog", "commercial agreement", "award"],
      "positive_keywords": ["awarded", "new customer", "multi-year contract", "expands partnership"],
      "negative_keywords": ["terminated", "canceled", "lost customer", "contract dispute"]
    },
    "product_technology": {
      "label": "Product & Technology",
      "reader_question": "Did a launch, product milestone, certification, or technology change monetization visibility?",
      "description": "Product launches, technical milestones, certifications, demos, adoption, or manufacturing ramps.",
      "base_materiality": 3,
      "long_relevance": 3,
      "short_relevance": 3,
      "default_direction": "mixed",
      "legacy_bucket": "Certification / Approval",
      "keywords": ["product launch", "launches", "technology milestone", "certification", "commercial launch", "production ramp", "patent"],
      "positive_keywords": ["approved", "certified", "successful launch", "commercial availability"],
      "negative_keywords": ["delay", "recall", "failed", "defect"]
